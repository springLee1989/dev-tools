{
  "version": 1,
  "name": "Modbus TCP 客户端主站",
  "description": "作为主站轮询 127.0.0.1:5020，并周期性写入设定值。可与 modbus-tcp-slave.json 同时加载。",
  "instances": [
    {
      "name": "scada-poller",
      "type": "modbus_tcp_client",
      "modbus_client": {
        "host": "127.0.0.1",
        "port": 5020,
        "unit_id": 1,
        "timeout": 3,
        "auto_reconnect": true,
        "operations": [
          {
            "name": "read-holding",
            "function": "read_holding_registers",
            "address": 0,
            "count": 4,
            "interval_ms": 1000,
            "data_type": "uint16"
          },
          {
            "name": "read-input-float",
            "function": "read_input_registers",
            "address": 0,
            "count": 2,
            "interval_ms": 1000,
            "data_type": "float32",
            "byte_order": "ABCD"
          },
          {
            "name": "write-setpoint",
            "function": "write_register",
            "address": 100,
            "count": 1,
            "interval_ms": 2000,
            "data_type": "uint16",
            "fields": [
              {
                "name": "setpoint",
                "type": "uint16",
                "mode": "random",
                "min": 0,
                "max": 1000,
                "decimals": 0
              }
            ]
          }
        ]
      }
    }
  ]
}
